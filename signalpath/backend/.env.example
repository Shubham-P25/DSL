ENV=dev
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
WHISPER_MODEL=base
WHISPER_COMPUTE=int8
WHISPER_DEVICE=cpu
FFMPEG_PATH=ffmpeg
GEMINI_MODEL=gemini-2.5-flash
JOB_WORKERS=1
CACHE_TTL_H=168
TMP_DIR=./data/tmp
LOG_LEVEL=INFO
GEMINI_RPM=10
MAX_CORRECTIONS_PER_JOB=300
TRANSLATOR=auto
MAX_BACKTRANS_PER_JOB=200
CHUNK_MIN_S=45
CHUNK_MAX_S=60
SUMMARY_MIN_SUPPORT=0.40
ASK_MIN_SCORE=0.30
EVENT_RETENTION_DAYS=7
