ENV=dev
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
ASR_PROVIDER=auto
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_DEVICE=cpu
ASR_BATCH=8
BEAM_SIZE=2
CPU_THREADS=0
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
GEMINI_RPM=10
MAX_CROSSCHECK_SEGS=40
MAX_VIDEO_MINUTES=60
YTDLP_COOKIES_FILE=cookies.txt
JOB_WORKERS=1
CACHE_TTL_H=168
TMP_DIR=./data/tmp
LOG_LEVEL=INFO
MAX_CORRECTIONS_PER_JOB=300
TRANSLATOR=auto
MAX_BACKTRANS_PER_JOB=200
CHUNK_MIN_S=45
CHUNK_MAX_S=60
SUMMARY_MIN_SUPPORT=0.40
ASK_MIN_SCORE=0.30
EVENT_RETENTION_DAYS=7
